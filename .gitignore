node_modules/
dist/
.env
.env.local
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/
.idea/
*.swp
*.swo
.git/
.claude/settings.local.json

# Production seed data — never commit real personal data
database/prod-initdb.d/500_prod_seed.sql

# Production env files with real values
frontend/.env.production

# Playwright generated output
e2e/playwright-report/
e2e/test-results/

# Deployment state — real values live on the host, not in git.
# Caddyfile is bind-mounted read-only into the running Caddy container, so a
# checkout that overwrote it would break live TLS on the next restart.
# Templates: Caddyfile.example, docker-compose.host.yml.example
Caddyfile
docker-compose.host.yml

# Deployment-owner images. The profile picture named by the production seed is
# personal data belonging to whoever runs the site, so only the placeholder
# shipped with the repo is tracked. Anything else here reaches the container
# through the Docker build context without being committed.
frontend/public/images/*
!frontend/public/images/placeholder-profile.jpeg

# Python bytecode and test caches from tools/
__pycache__/
*.py[cod]
.pytest_cache/
