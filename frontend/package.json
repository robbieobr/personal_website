{
  "name": "personal-website-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "i18next": "^26.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-i18next": "^17.0.16",
    "react-loading-skeleton": "^3.3.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_API_BACKEND=http://localhost:5001 vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "start": "npm run preview",
    "test": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest",
    "test:coverage": "cross-env NODE_OPTIONS=--no-experimental-webstorage vitest run --coverage",
    "mock": "tsx ./mock/mockServer.ts",
    "mock:install": "cd mock && npm install || true",
    "postinstall": "npm run mock:install"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "cross-env": "^10.1.0",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=26.0.0",
    "npm": ">=10.0.0"
  }
}
