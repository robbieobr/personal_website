{
  "name": "personal-website-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "i18next": "^26.4.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.13",
    "react-loading-skeleton": "^3.3.1"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "cross-env VITE_API_BACKEND=http://localhost:5001 vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview --host",
    "start": "npm run preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "mock": "tsx ./mock/mockServer.ts",
    "mock:install": "cd mock && npm install || true",
    "postinstall": "npm run mock:install"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.21.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=24.0.0",
    "npm": ">=10.0.0"
  }
}
