-- Production seed data template
-- Copy this file to 500_prod_seed.sql and fill in your real details.
-- 500_prod_seed.sql is gitignored and must never be committed.
--
-- tools/seo also reads this file when the production frontend image is built:
-- with real values in place it derives the document head, robots.txt,
-- sitemap.xml and the social card from the users, contact_info, job_history,
-- education and skills rows below. While the placeholders are still here it
-- writes none of them.

USE personal_website;

-- One row per person on the site.
-- Escape an apostrophe by doubling it, as in 'Your O''Name'.
-- profileImage is a path under frontend/public, so '/images/your-profile.png'
-- resolves to frontend/public/images/your-profile.png.
INSERT INTO users (name, title, profileImage, bio) VALUES
('Your Name', 'Your Title',
 '/images/your-profile.png',
 'A short bio about yourself.');

-- Contact details — user_id references the id assigned above (usually 1 for the first insert).
-- type is one of email, phone, website, github, linkedin; display_order sets the order they render in.
INSERT INTO contact_info (user_id, type, value, display_order) VALUES
(1, 'phone', '+1 (555) 000-0000', 1),
(1, 'email', 'you@example.com', 2),
(1, 'website', 'https://www.example.com', 3),
(1, 'github', 'https://github.com/your-handle', 4),
(1, 'linkedin', 'https://www.linkedin.com/in/your-handle', 5);

-- Job history — userId references the id assigned above (usually 1 for the first insert)
-- endDate is NULL for a current role
INSERT INTO job_history (userId, company, position, startDate, endDate, description) VALUES
(1, 'Current Company', 'Current Role', '2022-01-01', NULL,       'What you do there.'),
(1, 'Previous Company', 'Previous Role', '2019-06-01', '2021-12-31', 'What you did there.');

-- Education — same userId convention
INSERT INTO education (userId, institution, degree, field, startDate, endDate, description) VALUES
(1, 'Your University', 'Bachelor of Science', 'Your Field', '2015-09-01', '2019-05-31', 'Any notes about your degree.');

-- Skills — same userId convention; the first three appear on the social card
INSERT INTO skills (userId, skill) VALUES
(1, 'Your First Skill'),
(1, 'Your Second Skill'),
(1, 'Your Third Skill');
